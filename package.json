{
  "name": "intent-preserving-localization",
  "version": "1.0.0",
  "description": "Localizes educational English audio to Hindi while preserving pedagogical signal, with auditable reasoning. AI Builder Cup 2026.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server.js",
    "migrate": "node src/scripts/migrate.ts",
    "create-admin": "node src/scripts/create-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/scripts/migrate.ts",
    "db:prune": "node src/scripts/prune-expired.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "auth:schema": "npx auth@latest generate --config src/lib/auth.ts",
    "auth:secret": "npx auth@latest secret",
    "smoke:gemini": "node src/scripts/smoke-gemini.ts",
    "stage:analyze": "node src/scripts/stage-analyze.ts",
    "stage:adapt": "node src/scripts/stage-adapt.ts",
    "stage:critique": "node src/scripts/stage-critique.ts",
    "stage:synthesize": "node src/scripts/stage-synthesize.ts",
    "pipeline": "node src/scripts/pipeline.ts",
    "spike:tts": "node src/scripts/spike-tts.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "^2.21.0",
    "@sentry/node": "^10.72.0",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "resend": "^6.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
